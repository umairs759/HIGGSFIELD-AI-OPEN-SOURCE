{
  "name": "studio",
  "version": "1.0.0",
  "description": "Open Higgsfield AI studio components for Muapi",
  "main": "src/index.js",
  "module": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./providers/keyStore": "./src/providers/keyStore.js",
    "./providers/types": "./src/providers/types.js",
    "./providers/index": "./src/providers/index.js",
    "./catalog/availability": "./src/catalog/availability.js",
    "./services/router": "./src/services/router.js",
    "./services/promptEnhancer": "./src/services/promptEnhancer.js",
    "./models.js": "./src/models.js",
    "./components/RecommendationBadge": "./src/components/RecommendationBadge.jsx",
    "./components/ImageStudio": "./src/components/ImageStudio.jsx",
    "./components/VideoStudio": "./src/components/VideoStudio.jsx",
    "./components/LipSyncStudio": "./src/components/LipSyncStudio.jsx",
    "./components/CinemaStudio": "./src/components/CinemaStudio.jsx"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./dist/tailwind.css --minify",
    "build": "npm run build:css && babel src --out-dir dist --extensions .js,.jsx"
  },
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.0",
    "react-icons": "^5.0.1",
    "react-hot-toast": "^2.4.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.3"
  }
}
